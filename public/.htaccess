# Bierwagen Kasse — Apache config
# Wird per Vite automatisch von public/ nach dist/ kopiert.

Options -Indexes

# ----------------------------------------------------------------------
# HTTPS (empfohlen — PWA-Install und Service Worker brauchen HTTPS)
# Auskommentieren, wenn dein Hoster HTTPS bereits erzwingt.
# ----------------------------------------------------------------------
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} off
#   RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

# ----------------------------------------------------------------------
# Routing
#   /                → index.html              (Landing-Page)
#   /app/            → app/index.html          (PWA, SPA)
#   /impressum/      → impressum/index.html    (Standalone)
#   /datenschutz/    → datenschutz/index.html  (Standalone)
#
# Trailing-Slash und DirectoryIndex regelt der Server selbst,
# Rewrites brauchen wir nur für die SPA-Fallback der App.
# ----------------------------------------------------------------------
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Existierende Dateien/Verzeichnisse durchlassen
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA-Fallback nur innerhalb /app/
  RewriteRule ^app(/.*)?$ /app/index.html [L]
</IfModule>

# ----------------------------------------------------------------------
# Kompression
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# ----------------------------------------------------------------------
# MIME-Types
# ----------------------------------------------------------------------
AddType application/manifest+json .webmanifest
AddType image/svg+xml .svg

# ----------------------------------------------------------------------
# Cache-Header
# Hashed Assets (z. B. index-AbCd1234.js) bekommen 1 Jahr immutable.
# index.html / sw.js / manifest dürfen nicht aggressiv gecacht werden,
# sonst kommen Updates nicht beim User an.
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  # Hashed Assets im /assets/ Ordner: 1 Jahr immutable
  <FilesMatch "^.+\.(js|css|woff2?|png|jpg|jpeg|gif|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Service Worker: nie cachen
  <Files "sw.js">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </Files>

  # index.html: nicht cachen, sonst sehen User keine Updates
  <Files "index.html">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </Files>

  # Manifest und SVG-Icon: kurzes Cache OK
  <Files "manifest.webmanifest">
    Header set Cache-Control "public, max-age=3600"
  </Files>

  # Security
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "no-referrer"
</IfModule>

# ----------------------------------------------------------------------
# UTF-8 als Default
# ----------------------------------------------------------------------
AddDefaultCharset UTF-8
